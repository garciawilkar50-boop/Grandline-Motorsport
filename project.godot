; Grandline Motorsport — Android-first project settings

[application]

config/name="Grandline Motorsport"
config/icon="res://assets/brand/grandline-motorsport-icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4")

[autoload]

InputManager="*res://autoloads/input_manager.gd"
SaveManager="*res://autoloads/save_manager.gd"
GameManager="*res://autoloads/game_manager.gd"
RaceManager="*res://autoloads/race_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[physics]

common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
